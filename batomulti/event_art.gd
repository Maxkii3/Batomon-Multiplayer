extends RefCounted
## GENERATED by tools/gen_event_art.ps1 from art/event_banners - do not edit by hand.
## The BatoMulti event pictures (0.7.0): the 9 Tier 4 events, 240x150 PNG.

static var _cache := {}


## The event's picture, or null (the caller keeps the game's own picture then).
static func texture(id: String) -> Texture2D:
	if _cache.has(id):
		return _cache[id]
	var tex: Texture2D = null
	if PNG.has(id):
		var img := Image.new()
		if img.load_png_from_buffer(Marshalls.base64_to_raw(PNG[id])) == OK:
			tex = ImageTexture.create_from_image(img)
	_cache[id] = tex
	return tex

const PNG := {
	"bm_t4_fusion_altar": "",
	"bm_t4_champions_arrival": "",
	"bm_t4_legendary_armory": "",
	"bm_t4_awakening_rite": "",
	"bm_t4_chrono_surge": "",
	"bm_t4_mythic_forge": "",
	"bm_t4_mythic_vault": "",
	"bm_t4_paragon": "",
	"bm_t4_overdrive_core": "",
}
