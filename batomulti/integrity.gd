## Problems found (empty = intact). dir = the installed mod folder; directive = BM_LICENSE_DIRECTIVE.
static func check(directive: String, dir := "res://batomulti") -> Array:
	var bad := []
	if directive.strip_edges() == "":
		bad.append("license directive missing")
	elif directive.sha256_text() != LICENSE_SHA256:
		bad.append("license directive altered")
	if MANIFEST.size() < 20:
		bad.append("integrity manifest incomplete")
	var own := _self_hash(dir.path_join("integrity.gd"))
	if own != SELF_SHA256:
		bad.append("integrity.gd altered" if own != "" else "integrity.gd missing")
	for name in MANIFEST:
		var h := FileAccess.get_sha256(dir.path_join(name))
		if h == "":
			bad.append("missing: " + name)
		elif h != MANIFEST[name]:
			bad.append("modified: " + name)
	return bad


## SHA-256 of integrity.gd with its own SELF_SHA256 value blanked (the hash cannot contain itself).
static func _self_hash(path: String) -> String:
	if not FileAccess.file_exists(path):
		return ""
	var text := FileAccess.get_file_as_bytes(path).get_string_from_utf8()
	var re := RegEx.create_from_string("SELF_SHA256 := \"[0-9a-f]*\"")
	return re.sub(text, "SELF_SHA256 := \"\"").sha256_text()
